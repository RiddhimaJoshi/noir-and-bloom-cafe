{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app"
      "installCommand": "npm install --legacy-peer-deps"
    },
    "backend": {
       "root": "backend",
  "entrypoint": "server:api"
}
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
